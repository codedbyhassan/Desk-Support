# Signaling server URL (WebSocket)
VITE_SIGNALING_URL=ws://localhost:4000

# Optional TURN server (coturn) credentials for NAT traversal
VITE_TURN_URL=turn:your-turn-server:3478
VITE_TURN_USER=turnuser
VITE_TURN_PASS=turnpassword

# If using LiveKit or other SFU, keep keys here (server-side token generation recommended)
# LIVEKIT_API_KEY=your_livekit_api_key
# LIVEKIT_API_SECRET=your_livekit_api_secret
