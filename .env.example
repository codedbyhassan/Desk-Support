# Supabase public client configuration
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# WebSocket signaling server (only required by legacy/native call flows)
VITE_SIGNALING_URL=ws://localhost:4000

# Optional TURN server (coturn) credentials for NAT traversal
VITE_TURN_URL=turn:your-turn-server:3478
VITE_TURN_USER=turnuser
VITE_TURN_PASS=turnpassword

# Server-side integrations must never be exposed to the browser.
# DAILY_API_KEY=...
# PAYMENT_WEBHOOK_SECRET=...
# VAPID_PRIVATE_KEY=...
