# Public browser configuration
VITE_API_URL=
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Optional TURN server for WebRTC NAT traversal
VITE_TURN_URL=turn:your-turn-server:3478
VITE_TURN_USERNAME=turnuser
VITE_TURN_CREDENTIAL=turnpassword

# Optional Web Push public key (the private VAPID key stays in Supabase secrets)
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key

# Server-side integrations must never be exposed to the browser.
# VAPID_PRIVATE_KEY=...
# PAYMENT_WEBHOOK_SECRET=...
